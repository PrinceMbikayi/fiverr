{   
    "tags": {
        "allowUnknownTags": true 
    },
   
    "source": {
        "include": [    "src/components/objects/2ChLight",
                        "src/components/headers/header-with-back.js",
                        "src/components/objects/doorKeeper"
                    
                    ],       
        "includePattern": ".+\\.js(doc|x)?$",
        "excludePattern": "(^|\\/|\\\\)_"
    },
    "plugins": [
       
        "node_modules/better-docs/category"
       
       
    ],
    "templates": {
        "cleverLinks": false,
        "monospaceLinks": false,
        "search": true
    },
    "opts": {
        "destination": "./docs",
        "template": "node_modules/better-docs"
    }
}