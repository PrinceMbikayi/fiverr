diff --git a/node_modules/react-native-toggle-loud-speaker/LoudSpeaker.podspec b/node_modules/react-native-toggle-loud-speaker/LoudSpeaker.podspec
new file mode 100644
index 0000000..ffdc1a5
--- /dev/null
+++ b/node_modules/react-native-toggle-loud-speaker/LoudSpeaker.podspec
@@ -0,0 +1,23 @@
+require 'json'
+
+package = JSON.parse(File.read(File.join(__dir__, 'package.json')))
+
+Pod::Spec.new do |s|
+  s.name                = "LoudSpeaker"
+  s.version             = package['version']
+  s.summary             = package['description']
+  s.homepage            = "https://github.com/huutq88/react-native-loud-speaker"
+  s.license             = package['license']
+  s.author              = package['author']
+  s.source              = { :git => 'https://github.com/huutq88/react-native-loud-speaker.git', :tag => "v#{s.version}" }
+  s.default_subspec     = 'Core'
+  s.requires_arc        = true
+  s.platform            = :ios, "7.0"
+
+  s.dependency 'React'
+
+  s.subspec 'Core' do |ss|
+    ss.source_files     = "ios/*.{h,m}"
+  end
+
+end
